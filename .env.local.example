# --- Copy this file to .env.local and fill in values for local development ---

# GitHub Pages base path. Leave EMPTY for local dev (serves at http://localhost:3000/).
#  - Project page  (USER.github.io/REPO): the CI sets this to the repo name automatically.
#  - User page / custom domain:           set the repo Variable BASE_PATH=/  (normalizes to root).
NEXT_PUBLIC_BASE_PATH=

# Web3Forms access key — PUBLIC by design (it only routes mail to your verified inbox).
# Get a free key at https://web3forms.com  (used by the contact form, added in a later milestone).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Plausible analytics domain (e.g. asad.dev). Leave EMPTY to disable analytics entirely —
# the script is only injected when this is set. Add the site at https://plausible.io first.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Note: language (English / Urdu) is a RUNTIME toggle (the in-page switcher), not an env var —
# both ship in one build and switch instantly client-side. No NEXT_PUBLIC_LOCALE needed.
# The "Ask Asad" assistant also needs NO env var — it's fully local (data/ask-asad.ts).
